# Hermes Portable Configuration
# Generated by setup-portable.ps1 / generate_config.py
# Edit manually if needed

# =============================================================================
# [router] — LLM Gateway Configuration
# =============================================================================
router:
  # Base URL to 9router (local) or OpenRouter (cloud)
  base_url: "http://localhost:20128"

  # API key for authentication
  api_key: "{{ API_KEY }}"

  # Default model to use
  default_model: "openai/gpt-4o-mini"

  # Fallback models if default fails
  fallback_models:
    - "openai/gpt-4o"
    - "google/gemini-2.0-flash"

# =============================================================================
# [mcp_servers] — Embedded & External MCP Servers
# =============================================================================
mcp_servers:
  # Windows-MCP (embedded): Desktop automation via Windows UIAutomation
  windows:
    name: "windows"
    enabled: true
    command: "python"
    args:
      - "-m"
      - "windows_mcp"
      - "serve"
    transport: "stdio"
    supports_parallel_tool_calls: false
    connect_timeout: 30
    timeout: 60

# =============================================================================
# [gateway] — Messaging Platform Configuration
# =============================================================================
gateway:
  # Telegram Bot
  platforms:
    telegram:
      enabled: {{ TELEGRAM_ENABLED }}
      bot_token: "{{ TELEGRAM_TOKEN }}"
      # Allowed chat IDs (restrict who can control the bot)
      allowed_chat_ids: [{{ TELEGRAM_CHAT_ID }}]

# =============================================================================
# [portable] — Portable Mode Settings
# =============================================================================
portable:
  enabled: true

  # Copy Python runtime to %LOCALAPPDATA% for faster startup on slow USB drives
  copy_runtime_to_localappdata: false

  # Cloudflare Tunnel for remote dashboard access
  tunnel:
    enabled: false
    dashboard_port: 8787

  # Self-destruct / emergency wipe
  wipe:
    failed_auth_threshold: 0  # Disable auto-wipe for MVP

  # Live remote desktop streaming
  remote:
    enabled: false
    max_fps: 10
    quality: 50
    idle_timeout: 600

# =============================================================================
# [agent] — Agent Loop Settings
# =============================================================================
agent:
  # Max tool-call iterations per user message
  max_tool_iterations: 20

  # Timeout per tool call (seconds)
  tool_call_timeout_seconds: 60

  # Rate limiting: max tool calls per minute
  max_tool_calls_per_minute: 30

# =============================================================================
# [memory] — Conversation Memory Settings
# =============================================================================
memory:
  # Number of recent messages to include in context
  max_messages_per_chat: 20

  # Total message retention (older messages deleted)
  retention_messages: 1000

# =============================================================================
# [logging] — Logging Configuration
# =============================================================================
logging:
  level: "INFO"
  stderr_format: "text"

# =============================================================================
# [ux] — User Experience Settings
# =============================================================================
ux:
  # Streaming response updates
  streaming_enabled: true

  # Update frequency for typing indicators (seconds)
  typing_interval_seconds: 5

  # Delay before showing progress message (seconds)
  progress_delay_seconds: 3
