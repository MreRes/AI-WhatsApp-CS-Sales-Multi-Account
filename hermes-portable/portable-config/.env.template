# =============================================================================
# Hermes Portable - MASTER CREDENTIALS FILE
# Central hub untuk ALL configuration: API keys, tokens, user IDs, providers
# =============================================================================
#
# TIER 1: ESSENTIALS (auto-generated by setup-portable.ps1)
# TIER 2: MESSAGING (configure via config-setup.ps1 or manual edit)
# TIER 3: PROVIDERS (configure via 9router dashboard or manual edit)
#

# =============================================================================
# TIER 1: ESSENTIALS (Auto-generated on INSTALL.bat)
# =============================================================================

# Hermes Base Configuration
HERMES_API_KEY={{ HERMES_API_KEY }}
HERMES_BASE_URL=http://localhost:20128
HERMES_HOME={{ HERMES_HOME }}
HERMES_PORTABLE=true
HERMES_LOG_LEVEL=INFO

# 9router Service Secrets (auto-generated for security)
JWT_SECRET={{ JWT_SECRET }}
INITIAL_PASSWORD={{ INITIAL_PASSWORD }}
ROUTER9_DATA_DIR={{ ROUTER9_DATA_DIR }}

# =============================================================================
# TIER 2: MESSAGING PLATFORMS (Optional - add via config-setup.ps1)
# =============================================================================

# Telegram (Bot notifications + remote commands)
HERMES_TELEGRAM_TOKEN={{ TELEGRAM_TOKEN }}
HERMES_TELEGRAM_CHAT_ID={{ TELEGRAM_CHAT_ID }}

# WhatsApp (Optional - via Twilio or other provider)
# HERMES_WHATSAPP_ACCOUNT_SID=
# HERMES_WHATSAPP_AUTH_TOKEN=
# HERMES_WHATSAPP_PHONE_ID=
# HERMES_WHATSAPP_ALLOWED_NUMBERS=

# Discord (Optional)
# HERMES_DISCORD_TOKEN=
# HERMES_DISCORD_ALLOWED_USER_IDS=

# Slack (Optional)
# HERMES_SLACK_TOKEN=
# HERMES_SLACK_SIGNING_SECRET=
# HERMES_SLACK_ALLOWED_USER_IDS=

# =============================================================================
# TIER 3: LLM PROVIDERS (Configure via 9router dashboard)
# =============================================================================
# NOTE: Real provider keys (OpenRouter, Anthropic, Google, etc.) are
# configured INSIDE 9router dashboard at http://localhost:20128
# Hermes does NOT talk directly to providers — only to 9router.
#
# These are for reference/backup only:

# Provider Type (configured in 9router)
# 9ROUTER_PRIMARY_PROVIDER=openrouter
# 9ROUTER_PROVIDER_API_KEY=<configured in 9router dashboard>

# =============================================================================
# TIER 4: ADVANCED SETTINGS (Optional)
# =============================================================================

# Windows Defender Exclusion Path (for USB performance)
# DEFENDER_EXCLUSION_PATH=<auto-set by installer>

# Cloudflare Tunnel (auto-started by orchestrator, set at runtime)
# CLOUDFLARE_TUNNEL_URL_9ROUTER=<set by start_all.ps1>
# CLOUDFLARE_TUNNEL_URL_HERMES=<set by start_all.ps1>

# =============================================================================
# EDIT GUIDE
# =============================================================================
#
# To add/update credentials:
#
# OPTION A: Interactive Tool (Recommended)
#   Run: config-setup.ps1
#   Choose menu option to add/edit messaging platforms
#
# OPTION B: Manual Edit
#   Edit this file with your editor
#   Make sure to follow KEY=VALUE format (no spaces around =)
#   Uncomment lines (remove #) to enable
#
# OPTION C: Command Line
#   Set-Content -Path "data\.env" -Value "KEY=VALUE" -Append
#
# =============================================================================
